# Copie este arquivo para ".env" e preencha os valores.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# Gere uma chave nova com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-esta-chave-por-uma-gerada

# True apenas em desenvolvimento local. Em produção, deixe False ou omita.
DEBUG=True

# Domínios permitidos, separados por vírgula (ex: portal-finquant.onrender.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Necessário em produção atrás de HTTPS (ex: https://portal-finquant.onrender.com)
CSRF_TRUSTED_ORIGINS=

# Domínio usado pelo registro Site (django.contrib.sites) — afeta o "Ver no
# site" do admin e o login social. Em produção, defina com o domínio real
# (ex: portal-finquant.onrender.com).
SITE_DOMAIN=127.0.0.1:8000

# E-mail de contato mostrado no aviso de privacidade da avaliação, para quem
# quiser pedir a exclusão das próprias respostas (LGPD). Vazio = não mostra.
CONTATO_EMAIL=

# Em desenvolvimento local pode ficar vazio (usa SQLite automaticamente).
# Em produção (Render), defina com a URL do banco PostgreSQL gerenciado:
# DATABASE_URL=postgres://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=

# Login social (opcional). Deixe em branco para não mostrar o botão
# correspondente. Veja o passo a passo em
# docs/superpowers/specs/2026-08-17-login-social-design.md (Apêndice).
# Configure as credenciais SOMENTE aqui — nunca cadastre também um
# SocialApp pelo /admin/, isso causa erro de app duplicado no login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Envio de e-mail (recuperação de senha). Sem EMAIL_HOST, o e-mail só aparece
# no terminal do runserver. Com Gmail: EMAIL_HOST=smtp.gmail.com, o seu
# endereço em EMAIL_HOST_USER e uma "senha de app" (myaccount.google.com/apppasswords,
# exige verificação em duas etapas) em EMAIL_HOST_PASSWORD, nunca a senha normal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remetente mostrado no e-mail (ex: Portal FinQuant <seu-endereco@gmail.com>).
DEFAULT_FROM_EMAIL=
# Liga o formulário de "esqueci a senha" (True/False). Deixe False enquanto o
# envio não funcionar: o Render gratuito bloqueia as portas SMTP.
RECUPERACAO_SENHA_ATIVA=False
